# Скопируйте этот файл в .env.local (локально) или задайте переменные в Vercel:
# Project → Settings → Environment Variables.

# Токен бота от @BotFather. Нужен только на сервере (API route /api/rsvp),
# в браузер не попадает.
TELEGRAM_BOT_TOKEN=

# Необязательно. Чат, куда бот присылает ответы гостей. Если задано,
# перекрывает rsvp.telegramChatId из config/invite.ts.
#
# Как узнать chat_id:
#   1. Напишите боту любое сообщение (или добавьте его в группу и напишите там).
#   2. Откройте https://api.telegram.org/bot<ТОКЕН>/getUpdates
#   3. Возьмите число из "chat":{"id": ...}. У групп оно отрицательное.
TELEGRAM_CHAT_ID=

# Необязательно. Отдельные чаты сторон, если в конфиге rsvp.sides.ask: true.
# Ответы гостей кыз тарап (невесты) и бала тарап (жениха) придут каждый в свой
# чат. Не заданы — оба в общий чат, сторона стоит первой строкой сообщения.
# TELEGRAM_CHAT_ID_KYZ=
# TELEGRAM_CHAT_ID_BALA=

# Необязательно. Адрес сайта для картинки-превью ссылки, если у приглашения
# свой домен. На Vercel без своего домена задавать не нужно.
# SITE_URL=https://aibek-aizhan.example

# Необязательно. Адрес Bot API, если api.telegram.org недоступен с сервера
# и запросы идут через свой прокси или локальный Bot API server.
# TELEGRAM_API_BASE=https://api.telegram.org
